      "responses": {
        "primary": { "choices": [{ "message": { "content": "{\"ai_probability\": 0.93, \"confidence\": 0.88, \"signals\": [{\"name\": \"uniform rhythm\", \"direction\": \"AI\", \"strength\": 0.7}], \"phrases\": [{\"quote\": \"fast-paced digital landscape\", \"direction\": \"AI\", \"strength\": 0.8}]}" }, "finish_reason": "stop" }] },
