# AI Text Detection Pipeline — environment template.
# Copy to .env and fill in the secrets. .env is gitignored; this file is not.
#
# The reasoning behind the numeric defaults (benchmark measurements, threshold
# calibration, why this lane is the primary) lives in the comments of a real .env, in
# docs/free-model-research.md and in backend/seed.py. This template only lists the keys.
# One rule shapes the whole file: the seed reads it as ENVIRONMENT, and env outranks a
# baked value. So each key left unset here is a decision the shipped defaults make, and
# test_seed.py::test_the_deploy_templates_cannot_outvote_the_shipped_default_lane fails
# if this file ever names a different lane, switches the tie-break back on, or sets a
# per-lane tuning key that would re-band whichever model an operator chooses.

# --- LLM provider lanes ---------------------------------------------------
# Each lane is independently configurable: NVIDIA, OpenRouter, or a local
# OmniRoute gateway. Base URLs must NOT have a trailing slash.
PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_API_KEY=
# The primary lane is the promoted model (task #119: the previous occupant,
# nvidia/nemotron-3-ultra-550b-a55b, is delisted and no longer answers). A template naming a
# dead lane ships a deploy whose first detection is a 502, and env outranks the baked default,
# so this line IS the deployed primary. `seed.LANE_BANDS` holds this model's measured band
# (0.80 AI / 0.55 human) and applies it the moment nothing below overrides it.
PRIMARY_MODEL=z-ai/glm-5.3-flash

# The secondary lane is a tie-breaker: it only fires when the primary lands in the
# gray zone, reports low confidence, or returns salvaged JSON — so its latency is off
# the hot path, and its verdict replaces the primary's instead of averaging with it.
SECONDARY_BASE_URL=https://integrate.api.nvidia.com/v1
SECONDARY_API_KEY=
SECONDARY_MODEL=google/diffusiongemma-26b-a4b-it
# Set to true to buy the tie-break call back: gray-zone texts then get a second opinion
# instead of answering REVIEW_REQUIRED. A per-request lane_config.secondary.enabled does the
# same for one detection; the UI's Configuration tab has the switch, and it writes the model
# row's `enabled` column, which outranks this line once the row exists.
# Default is OFF as of 2026-10-16 (round 25c): on the 48-text corpus, with the deployed primary
# on its own measured band, the lane was asked about 3 texts and answered all 3 wrongly -- three
# human documents accused of being AI -- while the same ensemble with the lane off answers 45 of
# 48 at 44 correct / 1 wrong. It stays configured because on a drifting primary the same
# authority is worth 13 correct calls out of 15; it is a switch, not a deletion.
SECONDARY_ENABLED=false

# Other lane targets:
#   https://openrouter.ai/api/v1     with SECONDARY_MODEL=...:free
#   http://localhost:20128/v1        local OmniRoute; key may be empty

# Used by benchmark/ when sweeping a second provider alongside the lanes above.
# Not read by the workflow itself — the lanes only use PRIMARY_*/SECONDARY_*.
# The benchmark rotates _KEY and _KEY_2 across retries, because a :free 429 is one
# account hitting a shared upstream pool, not the request being impossible.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# --- Ensemble behaviour ---------------------------------------------------
# When to buy the second opinion is derived from the decision thresholds below: the
# secondary lane runs exactly when the primary would defer, so there is no separate
# gray-zone knob to keep in sync with them.
#
# Do NOT set a timeout here without meaning it for both lanes. One line, two lanes: the seed
# reads env before the per-model measurement in `seed.LANE_TIMEOUT_MS`, so `LLM_TIMEOUT_MS=90000`
# reverts the promoted primary to the ceiling it was raised off -- and 90000 is exactly what it
# was, which is how a boot silently undid the operator's choice (glm-5.3-flash measures p50 ~86 s
# on the free NVIDIA pool with a tail past 200 s, so its row carries 180000 and the backend waits
# 180 + 30 s). Leave it commented and each lane runs on its own measured ceiling.
# LLM_TIMEOUT_MS=90000
# Leave the answer uncapped. 0 (the default) sends no max_tokens field at all, so a lane that wants
# to quote four passages can actually finish its JSON. A positive number here is a deliberate cap --
# and a truncated answer reports no phrases, which is what the UI paints. Bands fitted under a cap
# have to be re-measured after changing it (docs/free-model-research.md, Round 15).
LLM_MAX_TOKENS=0

# --- Decision thresholds --------------------------------------------------
# These four are per-lane in every meaningful sense -- each model was fitted against its OWN
# cut -- but env is one line that applies to both lanes at once, and the seed consults env first.
# So setting them re-bands whichever model an operator pins to a lane, which is how a measured
# 0.80/0.55 primary turns into an unlabelled 0.69 one overnight, and how a global `0.80` once put
# the tie-break's diffusiongemma row on glm's ruler. `seed.LANE_BANDS` carries the promoted model's
# band and `seed.DEFAULT_BAND` the workflow's fallback (0.69 AI / 0.40 human, 0.60 confidence);
# the admin can change either lane's band per row in the UI, and that write survives a restart
# only while nothing here outranks it. Kept as comments: a deploy that means a global cut sets it
# deliberately, not by copying a template.
# AI_PROBABILITY_THRESHOLD=0.69
# AI_CONFIDENCE_THRESHOLD=0.60
# Below an HUMAN cut the primary is decisively human. Do not set it to a value the model can
# return exactly (it reports two decimals): an exact hit is a verdict, not a deferral. At 0.45 the
# 550B's exact 0.45 on an AI text was called HUMAN. 0.40 measures 45/3/0 with 0 false negatives on
# 48 HC3 texts OFFLINE (n8n/test-ensemble.js replay), vs 44/4/0 with 1 at 0.45. Live through the
# webhook the same build scores 41/48 with 6 false positives -- see docs/calibration.md, "Live
# verification of the tie-break build".
# HUMAN_PROBABILITY_THRESHOLD=0.40
# HUMAN_CONFIDENCE_THRESHOLD=0.60
SINGLE_MODEL_CONFIDENCE_PENALTY=1.0

# The secondary's own AI cut, applied only to texts the primary deferred. Below it the
# tie-break answers HUMAN. Diffusiongemma reports median 0.75 on real-human text, so
# the holdout put its usable AI signal at 0.90.
SECONDARY_DECISION_THRESHOLD=0.90

# --- Legacy full-pipeline (Docker/detector) only ---------------------------
# Not read by the AI-only workflow: it stopped blending probabilities across lanes
# that sit on different scales. detector/classifier.py still uses these.
PRIMARY_MODEL_WEIGHT=0.9
SECONDARY_MODEL_WEIGHT=0.1
MAX_MODEL_DISAGREEMENT=0.30

# --- Per-request overrides (Angular UI) -----------------------------------
# A request may override a lane with body.lane_config {primary,secondary}
# {base_url,model} and supply its own key via the x-primary-api-key /
# x-secondary-api-key headers. Exact-host allowlist, no suffix matching; any
# port is allowed on an allowed host. List every host both lanes will resolve
# to, including the defaults, or the request is rejected.
ALLOWED_LLM_HOSTS=localhost,127.0.0.1,::1,integrate.api.nvidia.com,openrouter.ai
ALLOW_BYOK=false

# --- Versioning -----------------------------------------------------------
DETECTOR_VERSION=1.0.0
FEATURE_SCHEMA_VERSION=1.0.0
CLASSIFIER_VERSION=1.0.0
THRESHOLD_VERSION=2.0.0

# --- Text limits and chunking ---------------------------------------------
MIN_TEXT_LENGTH=10
MAX_TEXT_LENGTH=50000
MAX_CHUNK_CHARS=4000
CHUNK_OVERLAP=200

# --- Provider rate limits (free tier; adjust per provider) -----------------
NVIDIA_RPM=30
NVIDIA_TPM=50000
NVIDIA_RPD=unlimited
OPENROUTER_RPM=20
OPENROUTER_RPD=200
CEREBRAS_RPM=60
CEREBRAS_TPM=1000000
CEREBRAS_RPD=unlimited

# --- Cache and database (legacy full pipeline) -----------------------------
DB_NAME=ai_detector
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@localhost:3306/${DB_NAME}
CACHE_ENABLED=true
CACHE_TTL_HOURS=168

# --- Internal service URLs (legacy full pipeline) --------------------------
WATERMARK_DETECTOR_URL=http://watermark-detector:8000
PROVENANCE_SERVICE_URL=http://provenance-service:8000
DETECTOR_SERVICE_URL=http://detector:5000

# --- n8n ------------------------------------------------------------------
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
# Must be false: the workflow's Code nodes read provider config from $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Docker Compose deploy (docker-compose.yml at the repo root) -----------
# Compose reads THIS file (repo-root .env) for ${VAR} interpolation, and the backend
# bind-mounts it so seed.py can import the lanes/keys/models/thresholds above. The vars
# below are deploy-specific; all have safe defaults in docker-compose.yml, so they are
# optional until you want to override one. See docker/DEPLOY.md.
#
# First-boot administrator (seeded once, on the backend's very first start).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Cookie-signing secret. Leave empty to use the persisted Fernet key file in the
# backend_data volume (stable across restarts). Set a long random string for multiple
# backend replicas so they all sign sessions identically. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Host port the SPA is published on (80 for a bare host). n8n editor port.
WEB_PORT=8080
N8N_PORT=5678
# Set true once a TLS terminator sits in front of nginx, so the session cookie is HTTPS-only.
USE_SECURE_COOKIES=false
# Backend concurrency. Each gunicorn worker runs its own BYOK purger.
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
