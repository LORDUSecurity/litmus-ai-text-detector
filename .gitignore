# --- Secrets -------------------------------------------------------------
# .env holds live provider API keys, the n8n admin password and the DB
# password. Never commit it. .env.example is the shareable template.
.env
**/.env
!.env.example
*.pem
*.key

# --- n8n runtime state ---------------------------------------------------
# The SQLite database persists webhook run data, which is exactly where a
# BYOK key would land. Keep it out of version control.
.n8n/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node / Angular ------------------------------------------------------
node_modules/
.angular/
dist/
npm-debug.log*
yarn-error.log*

# --- Flask backend state -------------------------------------------------
# detector.sqlite3 holds the encrypted provider keys and every detection row;
# backend-secret.key is the Fernet master key that decrypts them. Neither may
# ever be committed -- the pair together is the secret store.
ai-text-detector/backend/data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Benchmark source downloads ---------------------------------------
# 11 MB of public-domain books fetched by benchmark/build-book-corpus.js. The derived
# corpus (corpus-books.json) is committed; the raw ebooks are reproducible from
# Project Gutenberg, so they stay out of git.
ai-text-detector/benchmark/book-sources/

# --- Local Windows exe build ------------------------------------------
# Staging folder + PyInstaller intermediates + the compiled artifacts for the
# single-file local app. All regenerated by installer/BUILD.md; the 40 MB exe and
# the Inno Setup output are build products, never committed.
ai-text-detector/.localbuild/
ai-text-detector/build_local/
ai-text-detector/AI-Text-Detector.spec
ai-text-detector/installer/Output/

# --- Sites publication recovery records --------------------------------
# prepare_site writes these; they embed a base64 copy of the frozen draft plus
# action/deployment ids for one machine, so they are never committed.
ai-text-detector/public-site/*.qoder.site
ai-text-detector/*.qoder.site

# --- Scratch for live probes -------------------------------------------
# Fonts and payloads the verifier scripts stage in order to fetch them; the
# real copies live in frontend/public/fonts and public-site/dist/fonts.
ai-text-detector/.probe/

# --- Live-probe scratch -------------------------------------------------
# Screenshots and throwaway dev-proxy config a verification run stages in order to
# drive the app over CDP. The README's copies live in ai-text-detector/docs/assets;
# these are the working shots that produced them.
.qoder-screens/
ai-text-detector/frontend/proxy.live.json

# --- Run logs -----------------------------------------------------------
# Every file here is the transcript of a measurement (a capture round, a build, a
# verifier run), and the numbers they produced are already recorded in the ranking,
# the research notes and the deposit manifest. They are kept on disk for the run they
# belong to and never committed: a capture log quotes request bodies and endpoint URLs
# that have no business in a public history.
ai-text-detector/benchmark/*.log
ai-text-detector/benchmark/logboot/
ai-text-detector/benchmark/_catalog_dump.txt

# --- Crash logs ---------------------------------------------------------
# JVM crash dumps from an n8n boot. Regenerated on the next crash, useful for exactly
# one thing: nothing.
hs_err_pid*.log
replay_pid*.log

# --- Empty legacy file --------------------------------------------------
# A 0-byte SQLite file the very first boot created before the path moved to
# backend/data/. Nothing reads it; it was tracked by mistake.
ai-text-detector/detector.db
